<TableView class="oracle.dbtools.crest.model.design.relational.TableView" directorySegmentName="seg_0" id="1E5308AD-FA63-D6E6-C313-C7DCA3FD6CFF" name="TRADE_SZ_STATUS_V">
<createdBy>jjso0</createdBy>
<createdTime>2026-10-24 18:45:58 UTC</createdTime>
<ownerDesignName>campusmarket</ownerDesignName>
<ordsAlias>view_1</ordsAlias>
<userDefined>true</userDefined>
<userDefinedSQL><![CDATA[SELECT t.TRADE_ID,
       t.SAFE_ZONE_ID,
       MAX(CASE WHEN r.RECORD_ACTION = 'DROP_OFF' THEN r.RECORDED_AT END) AS DROP_OFF_AT,
       MAX(CASE WHEN r.RECORD_ACTION = 'PICK_UP'  THEN r.RECORDED_AT END) AS PICK_UP_AT,
       CASE
         WHEN COUNT(CASE WHEN r.RECORD_ACTION = 'PICK_UP'  THEN 1 END) > 0 THEN 'COMPLETED'
         WHEN COUNT(CASE WHEN r.RECORD_ACTION = 'DROP_OFF' THEN 1 END) > 0 THEN 'STORED'
         ELSE 'WAITING'
       END AS SZ_STATUS
FROM TRADE t
LEFT JOIN SAFE_ZONE_RECORD r ON r.TRADE_ID = t.TRADE_ID
GROUP BY t.TRADE_ID, t.SAFE_ZONE_ID]]></userDefinedSQL>
